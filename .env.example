# Supabase Configuration for Policy Tracker
# Replace with your actual Supabase project URL and anon public key.
# Note: In Expo, environment variables prefixed with EXPO_PUBLIC_ are bundled into client code.
# NEVER put service_role secret keys here!

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
